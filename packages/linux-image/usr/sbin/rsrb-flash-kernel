#!/bin/sh
# rsrb-flash-kernel [-y] [VERSION] – write an installed RSRB kernel to the RS812 SPI flash (mtd1).
# U-Boot (mtd0) is never written. The image is verified by reading it back.
set -eu
K=/usr/lib/rsrb/kernel
die() { echo "rsrb-flash-kernel: $*" >&2; exit 1; }
yes=; [ "${1:-}" = -y ] && { yes=1; shift; }
V=${1:-$(ls "$K" 2>/dev/null | sed -n 's/^uImage-//p' | sort -V | tail -1)}
IMG=$K/uImage-$V
[ "$(id -u)" = 0 ] || die "run as root"
[ -n "$V" ] && [ -f "$IMG" ] || die "no kernel image found ($IMG)"
tr -d '\0' < /proc/device-tree/model 2>/dev/null | grep -q "RS812" || die "this is not a Synology RS812"
[ -d "/usr/lib/modules/$V" ] || die "modules for $V are missing"
n=$(stat -c%s "$IMG"); [ "$n" -le 2097152 ] || die "image too large for mtd1"
# the unlock variant of spi-nor must match the RUNNING kernel
KO=$K/spi-nor-unlock-$(uname -r).ko
[ -f "$KO" ] || die "no flash unlock module for the running kernel $(uname -r)"

if [ -e /dev/mtd1 ] && [ "$(head -c "$n" /dev/mtd1 | sha256sum)" = "$(sha256sum < "$IMG")" ]; then
  echo "Kernel $V is already in the flash."; exit 0
fi
echo "This writes RSRB kernel $V ($n bytes) to the SPI flash (mtd1)."
echo "If the new kernel does not boot, recovery needs the serial console (see rs812-debian README)."
if [ -z "$yes" ]; then printf 'Continue? [y/N] '; read -r a; [ "$a" = y ] || [ "$a" = Y ] || die "cancelled"; fi

rmmod mtdblock 2>/dev/null || true; rmmod spi_nor 2>/dev/null || true
insmod "$KO"; sleep 2
grep -q '"zImage"' /proc/mtd || die "mtd1 'zImage' not found"
flash_lock --islocked /dev/mtd1 | grep -q unlocked || die "flash still locked"
before0=$(sha256sum < /dev/mtd0)
flashcp -v "$IMG" /dev/mtd1
[ "$(head -c "$n" /dev/mtd1 | sha256sum)" = "$(sha256sum < "$IMG")" ] || die "READ-BACK MISMATCH – do not reboot, flash again"
[ "$(sha256sum < /dev/mtd0)" = "$before0" ] || die "mtd0 changed?!"
echo "Kernel $V written and verified. Bootloader untouched. Reboot to start it."
