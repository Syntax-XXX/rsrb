#!/bin/sh
set -e
undivert() {
  [ -e "$1.debian" ] && mv -f "$1.debian" "$1"
  dpkg-divert --package rsrb-release --remove --no-rename --divert "$1.debian" "$1" >/dev/null
}
if [ "$1" = remove ] || [ "$1" = abort-install ] || [ "$1" = disappear ]; then
  undivert /usr/lib/os-release
  undivert /etc/issue
fi
