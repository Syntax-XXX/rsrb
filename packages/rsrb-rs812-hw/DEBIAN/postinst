#!/bin/sh
set -e
if [ "$1" = configure ]; then
  # earlier installs had the fan control as loose files
  if grep -qs /usr/local/sbin/rs812-fan /etc/systemd/system/rs812-fan.service; then
    rm -f /etc/systemd/system/rs812-fan.service /usr/local/sbin/rs812-fan
  fi
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable rs812-fan.service >/dev/null 2>&1 || true
  systemctl enable rs812-panel.service >/dev/null 2>&1 || true
  for u in rs812-fan rs812-panel; do
    if [ -n "$2" ] || systemctl is-active -q $u.service; then systemctl restart $u.service || true
    else systemctl start $u.service || true; fi
  done
  # apply the tuning rules now too (the network rule runs on "add", i.e. at boot)
  udevadm control --reload-rules 2>/dev/null || true
  for n in /sys/bus/platform/drivers/mv643xx_eth_port/*/net/*; do
    [ -e "$n" ] && ethtool -C "${n##*/}" rx-usecs 100 2>/dev/null || true
  done
  udevadm trigger --action=change --subsystem-match=block --sysname-match='md*' 2>/dev/null || true
fi
