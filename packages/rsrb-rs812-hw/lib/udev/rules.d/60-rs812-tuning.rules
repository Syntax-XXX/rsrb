# RSRB tuning for the Synology RS812, measured on the hardware (iperf3 / dd, 2026-11-12)

# Ethernet (mv643xx_eth): RX interrupt coalescing 100 µs instead of 250 µs
# -> receive 390 -> 480 Mbit/s, send 888 -> 917 Mbit/s (the CPU is the limit, shorter waits keep TCP flowing)
ACTION=="add", SUBSYSTEM=="net", DRIVERS=="mv643xx_eth_port", RUN+="/usr/sbin/ethtool -C $name rx-usecs 100"

# Data arrays (md2 and up, as DSM numbers them): 4 MiB read-ahead instead of 128 KiB
# -> sequential reads +13 % (97 -> 110 MB/s); root (md0) and swap (md1) keep the default
ACTION=="add|change", SUBSYSTEM=="block", KERNEL=="md[2-9]|md[1-9][0-9]", ATTR{queue/read_ahead_kb}="4096"
